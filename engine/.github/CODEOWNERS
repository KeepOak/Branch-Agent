# Hard security tier: an independent SecOps review is required for every author.
# Enable required code-owner reviews and dismiss stale approvals in branch protection.
# Last matching rule wins. Keep SecOps the sole owner of these paths: listing
# another team on the same line would allow that team to satisfy the requirement.

# Security policy and ownership determine who can approve protected changes.
/.github/CODEOWNERS @branch/branch-secops
/SECURITY.md @branch/branch-secops

# CodeQL policy, queries, and execution; vulnerability update and workflow-audit policy.
/.github/codeql/ @branch/branch-secops
/.github/workflows/codeql*.yml @branch/branch-secops
/.github/dependabot.yml @branch/branch-secops
/.github/zizmor.yml @branch/branch-secops

# Security-review classification, authorization, publication, and trusted API reads.
/.github/workflows/security-review.yml @branch/branch-secops
/scripts/github/dependency-guard.mjs @branch/branch-secops
/scripts/github/security-sensitive-guard.mjs @branch/branch-secops
/scripts/github/security-review.mjs @branch/branch-secops
/scripts/github/security-review-event.mjs @branch/branch-secops
/scripts/github/security-review-rollout.mjs @branch/branch-secops
/.github/security-review-policy.yml @branch/branch-secops
/.github/actions/setup-security-review/ @branch/branch-secops
/scripts/github/security-review-policy.mjs @branch/branch-secops
/scripts/github/guard-review.mjs @branch/branch-secops
/scripts/github/guard-shared.mjs @branch/branch-secops
/scripts/lib/bounded-response.mjs @branch/branch-secops

# Release workflow and its supporting release-path checks.
/.github/workflows/branch-npm-release.yml @branch/branch-release-managers
/docs/reference/RELEASING.md @branch/branch-release-managers
/scripts/branch-npm-publish.sh @branch/branch-release-managers
/scripts/branch-npm-release-check.ts @branch/branch-release-managers
/scripts/release-check.ts @branch/branch-release-managers
