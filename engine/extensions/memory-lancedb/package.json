{
  "name": "@branch/memory-lancedb",
  "version": "2026.9.8",
  "description": "Branch Agent LanceDB-backed long-term memory plugin with auto-recall, auto-capture, and vector search.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "apache-arrow": "21.2.0",
    "openai": "7.23.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@lancedb/lancedb": "0.39.0",
    "@branch/plugin-sdk": "workspace:*"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "0.39.0",
    "@lancedb/lancedb-linux-arm64-gnu": "0.39.0",
    "@lancedb/lancedb-linux-arm64-musl": "0.39.0",
    "@lancedb/lancedb-linux-x64-gnu": "0.39.0",
    "@lancedb/lancedb-linux-x64-musl": "0.39.0",
    "@lancedb/lancedb-win32-arm64-msvc": "0.39.0",
    "@lancedb/lancedb-win32-x64-msvc": "0.39.0"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/memory-lancedb",
      "npmSpec": "@branch/memory-lancedb",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.31"
    },
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "branchVersion": "2026.9.8",
      "workerEntries": [
        "./lancedb-runtime.ts"
      ]
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
