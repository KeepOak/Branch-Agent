{
  "name": "@branch/tokenjuice",
  "version": "2026.9.7",
  "description": "Branch Agent tokenjuice exec output compaction plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "tokenjuice": "0.8.5"
  },
  "peerDependencies": {
    "branch": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "branch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*",
    "branch": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/tokenjuice",
      "npmSpec": "@branch/tokenjuice",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "branchVersion": "2026.9.7",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
