{
  "name": "@branch/diffs-language-pack",
  "version": "2026.9.8",
  "description": "Branch Agent diffs viewer syntax highlighting language pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@branch/diffs-language-pack",
      "clawhubSpec": "clawhub:@branch/diffs-language-pack",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.27"
    },
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "assetScripts": {
      "build": "node --import tsx ../../scripts/build-diffs-viewer-runtime.mts full"
    },
    "build": {
      "bundledDist": false,
      "branchVersion": "2026.9.8",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
