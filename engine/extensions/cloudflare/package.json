{
  "name": "@branch/cloudflare",
  "version": "2026.9.8",
  "description": "Cloudflare R2 storage provider for Branch.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/cloudflare",
      "npmSpec": "@branch/cloudflare",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.7"
    },
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "branchVersion": "2026.9.8"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
