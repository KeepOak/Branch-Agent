{
  "name": "@branch/openshell-sandbox",
  "version": "2026.9.7",
  "description": "Branch Agent sandbox backend for the NVIDIA OpenShell CLI with mirrored local workspaces and SSH command execution.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@openclaw/fs-safe": "0.22.0",
    "p-limit": "7.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/openshell-sandbox",
      "npmSpec": "@branch/openshell-sandbox",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "branchVersion": "2026.9.7",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
