{
  "name": "@branch/canopy",
  "version": "2026.9.8",
  "private": true,
  "description": "Branch Agent dashboard canopy plugin",
  "type": "module",
  "dependencies": {
    "@branch/gateway-protocol": "workspace:*",
    "@branch/canopy-contract": "workspace:*",
    "lit": "3.3.3",
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@branch/gateway-client": "workspace:*",
    "@branch/normalization-core": "workspace:*",
    "@branch/plugin-sdk": "workspace:*",
    "branch": "workspace:*"
  },
  "peerDependencies": {
    "branch": ">=2026.9.8"
  },
  "peerDependenciesMeta": {
    "branch": {
      "optional": true
    }
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./browser/index.ts",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/canopy",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/canopy --copy",
      "buildOutputs": [
        "branch.plugin.json"
      ]
    },
    "build": {
      "workerEntries": [
        "./src/sqlite-store.worker.ts"
      ]
    }
  }
}
