{
  "name": "@branch/voice-call",
  "version": "2026.9.7",
  "description": "Branch Agent voice-call plugin for Twilio, Telnyx, and Plivo phone calls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*",
    "branch": "workspace:*"
  },
  "peerDependencies": {
    "branch": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "branch": {
      "optional": true
    }
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-api.ts",
    "install": {
      "clawhubSpec": "clawhub:@branch/voice-call",
      "npmSpec": "@branch/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "branchVersion": "2026.9.7"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
