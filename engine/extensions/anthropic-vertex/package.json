{
  "name": "@branch/anthropic-vertex-provider",
  "version": "2026.9.8",
  "description": "Branch Agent Anthropic Vertex provider plugin for Claude models on Google Vertex AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "0.19.10",
    "google-auth-library": "11.1.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/anthropic-vertex-provider",
      "npmSpec": "@branch/anthropic-vertex-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "branchVersion": "2026.9.8",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
