{
  "id": "traversaal",
  "categories": ["web"],
  "activation": {
    "onStartup": false
  },
  "setup": {
    "providers": [
      {
        "id": "traversaal",
        "envVars": ["TRAVERSAAL_API_KEY"]
      }
    ]
  },
  "uiHints": {
    "webSearch.apiKey": {
      "label": "Traversaal Ares API Key",
      "help": "Fallback: TRAVERSAAL_API_KEY environment variable.",
      "sensitive": true
    }
  },
  "contracts": {
    "webSearchProviders": ["traversaal"]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "webSearch.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "configGroups": [
    {
      "id": "web-search",
      "title": "Web search",
      "order": 10,
      "properties": ["webSearch"]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": ["string", "object"]
          }
        }
      }
    }
  }
}
