{
  "name": "@branch/apple-fm-provider",
  "version": "2026.9.8",
  "private": true,
  "description": "Branch Agent on-device Apple Foundation Models provider",
  "type": "module",
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "branchVersion": "2026.9.8",
      "staticAssets": [
        {
          "source": "./assets/AppleFoundationModels.swift",
          "output": "assets/AppleFoundationModels.swift"
        }
      ]
    }
  }
}
