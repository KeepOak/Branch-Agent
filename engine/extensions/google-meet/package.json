{
  "name": "@branch/google-meet",
  "version": "2026.9.7",
  "description": "Branch Agent Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "jszip": "3.10.2",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*",
    "branch": "workspace:*"
  },
  "peerDependencies": {
    "branch": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "branch": {
      "optional": true
    }
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/google-meet",
      "npmSpec": "@branch/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "branchVersion": "2026.9.7"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
