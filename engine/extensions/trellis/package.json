{
  "name": "@branch/trellis",
  "version": "2026.9.7",
  "description": "Trellis workflow tool plugin for typed pipelines and resumable approvals.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@clawdbot/lobster": "2026.9.14",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/trellis",
      "npmSpec": "@branch/trellis",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "branchVersion": "2026.9.7"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
