{
  "name": "@branch/logbook",
  "version": "2026.9.7",
  "description": "Branch Agent automatic work journal plugin",
  "type": "module",
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*",
    "branch": "workspace:*"
  },
  "peerDependencies": {
    "branch": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "branch": {
      "optional": true
    }
  },
  "branch": {
    "build": {
      "bundledDist": true,
      "workerEntries": [
        "./src/store.worker.ts"
      ],
      "branchVersion": "2026.9.7"
    },
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/logbook",
      "npmSpec": "@branch/logbook",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.5"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  }
}
