{
  "name": "@branch/amazon-bedrock-provider",
  "version": "2026.9.7",
  "description": "Branch Agent Amazon Bedrock provider plugin with model discovery, embeddings, and guardrail support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1136.0",
    "@aws-sdk/client-bedrock-runtime": "3.1136.0",
    "@aws-sdk/credential-provider-node": "3.972.83",
    "@smithy/node-http-handler": "4.12.1",
    "@smithy/types": "4.18.0"
  },
  "devDependencies": {
    "@branch/plugin-sdk": "workspace:*"
  },
  "branch": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@branch/amazon-bedrock-provider",
      "npmSpec": "@branch/amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "branchVersion": "2026.9.7",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
