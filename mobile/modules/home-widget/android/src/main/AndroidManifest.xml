<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name=".HomeWidgetProvider"
      android:exported="true"
      android:label="@string/branch_home_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/branch_home_widget_info" />
    </receiver>
    <service
      android:name=".TalkTileService"
      android:exported="true"
      android:icon="@drawable/branch_talk_tile"
      android:label="@string/branch_talk_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>
</manifest>
