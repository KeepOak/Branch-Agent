{
  "expo": {
    "name": "Branch",
    "slug": "branch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.keepoak.branch",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Branch uses the camera to scan the pairing code on your computer.",
        "NSUserNotificationsUsageDescription": "Branch sends notifications when something on your computer needs your approval.",
        "NSLocalNetworkUsageDescription": "Branch connects to the Branch app on your computer over your home network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.keepoak.branch",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Branch uses the camera to scan the pairing code on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f6f8f9",
          "dark": {
            "backgroundColor": "#0b0f12"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
