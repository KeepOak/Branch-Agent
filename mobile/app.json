{
  "expo": {
    "name": "Branch Agent",
    "slug": "branch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Branch Agent",
        "NSLocalNetworkUsageDescription": "Branch connects to the Branch app on your computer over your home network.",
        "NSPhotoLibraryUsageDescription": "Branch uses your photos so you can send a picture in a chat.",
        "NSCameraUsageDescription": "Branch uses the camera to read the pairing code on your computer and to take a picture to send in a chat.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.keepoak.branch",
      "versionCode": 4,
      "label": "Branch Agent",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#153a28"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Branch uses the camera to read the pairing code on your computer and to take a picture to send in a chat.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Branch uses your photos so you can send a picture in a chat.",
          "cameraPermission": "Branch uses the camera to read the pairing code on your computer and to take a picture to send in a chat.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#f6f8f9",
          "dark": {
            "backgroundColor": "#0b0f12"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withApkInstaller.js",
      "./plugins/withReleaseSigning.js",
      "expo-updates"
    ]
  }
}
